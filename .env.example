# Copie este archivo como .env y ajuste los valores. NUNCA suba .env a GitHub (ya está en .gitignore).

# Instrumentos y horizonte de las alertas en vivo
TB_INSTRUMENTS=BTCUSDT
TB_HORIZON_MIN=1
# Horas permitidas en hora de Bogotá, formato inicio-fin (fin excluido)
TB_HOURS_BOGOTA=0-24

# Contrato: binaria | contado
TB_CONTRACT=binaria
# Pago neto de la opción (0.85 = gana 85 % de lo apostado). Márquelo como verificado SOLO si lo
# comprobó en el intermediario para ese activo y esa hora.
TB_PAYOUT=0.85
TB_PAYOUT_VERIFIED=false
TB_TIE_RULE=refund
TB_BROKER=ninguno (solo alertas)

# Umbral de calidad: EV mínimo (unidades de apuesta) para alertar
TB_EV_MARGIN=0.02
TB_SPOT_EV_MARGIN_FRAC=0.25
# Mostrar señales de modelos NO validados como «EXPERIMENTAL — NO OPERAR».
# No hace falta para el modelo en observación en vivo (VALIDADO_HOLDOUT): ese se registra siempre.
TB_SHOW_EXPERIMENTAL=false

# Límites de riesgo (cuenta simulada)
TB_STAKE=1
TB_MAX_ALERTS_PER_DAY=20
TB_MAX_DAILY_LOSS=5
TB_MAX_CONSECUTIVE_LOSSES=5

# Datos
# Segundos tras el cierre de cada vela antes de decidir. Binance publica la vela cerrada y definitiva a
# los ~0,3 s (medido el 2026-10-03); 1 s deja margen para un desfase de reloj. Menos espera = entrada
# más cercana a la ideal (la ventaja de BTC del estudio solo existía con entrada inmediata).
TB_FEED_LATENCY_S=1
TB_MAX_STALENESS_S=90
# Calendario económico opcional (CSV: event_time_utc,currency,impact,title[,available_at_utc])
TB_CALENDAR_CSV=

# Canales: console,file,telegram,webhook
TB_NOTIFY=console,file
TB_TELEGRAM_BOT_TOKEN=
TB_TELEGRAM_CHAT_ID=
TB_WEBHOOK_URL=

# Dinero real: DESHABILITADO. No defina TB_REAL_MONEY. Ver docs/03_fase2_intermediarios.md.
